{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gitops.vcf.example/content-identity/v1alpha1",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {"enum": ["gitops.vcf.example/v1alpha1"]},
    "kind": {"enum": ["ContentIdentity"]},
    "metadata": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "remoteId": {"type": "string", "minLength": 1}
      }
    },
    "spec": {
      "type": "object",
      "required": ["product", "type", "path", "scope", "usages"],
      "additionalProperties": false,
      "properties": {
        "product": {"enum": ["automation", "orchestrator"]},
        "type": {"type": "string", "minLength": 1},
        "path": {"type": "string", "pattern": "^content/"},
        "scope": {"type": "object"},
        "usages": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
