{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gitops.vcf.example/gitops-policy/v1alpha1",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {"enum": ["gitops.vcf.example/v1alpha1"]},
    "kind": {"enum": ["GitOpsPolicy"]},
    "metadata": {"type": "object", "required": ["name"], "additionalProperties": false, "properties": {"name": {"type": "string", "minLength": 1}}},
    "spec": {
      "type": "object",
      "required": ["maxPlanOperations", "productionPattern", "allowProductionMutation", "requireExplicitCreate", "requireExplicitDelete"],
      "additionalProperties": false,
      "properties": {
        "maxPlanOperations": {"type": "integer", "minimum": 1, "maximum": 100},
        "productionPattern": {"type": "string", "minLength": 1},
        "allowProductionMutation": {"type": "boolean"},
        "requireExplicitCreate": {"type": "boolean"},
        "requireExplicitDelete": {"type": "boolean"}
      }
    }
  }
}
