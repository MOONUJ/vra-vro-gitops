{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gitops.vcf.example/reconciliation-loop/v1alpha1",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {"enum": ["gitops.vcf.example/v1alpha1"]},
    "kind": {"enum": ["ReconciliationLoop"]},
    "metadata": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "spec": {
      "type": "object",
      "required": ["enabled", "repositoryMode", "instanceRef", "lifecycle", "products", "interval", "mode", "retry", "approval"],
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "repositoryMode": {"enum": ["instance"]},
        "instanceRef": {"type": "string", "minLength": 1},
        "lifecycle": {"enum": ["day0", "day1", "day2"]},
        "products": {"type": "array", "minItems": 1, "items": {"enum": ["automation", "orchestrator"]}},
        "interval": {"type": "string", "pattern": "^[1-9][0-9]*[smh]$"},
        "mode": {"enum": ["observe"]},
        "retry": {"type": "object", "required": ["maxAttempts"], "additionalProperties": false, "properties": {"maxAttempts": {"type": "integer", "minimum": 1, "maximum": 10}, "maxElapsedSeconds": {"type": "integer", "minimum": 1, "maximum": 3600}, "backoffSeconds": {"type": "integer", "minimum": 0, "maximum": 60}}},
        "repeatDriftThreshold": {"type": "integer", "minimum": 1, "maximum": 100},
        "approval": {"type": "object", "required": ["requiredFor"], "additionalProperties": false, "properties": {"requiredFor": {"type": "array", "items": {"type": "string"}}}}
      }
    }
  }
}
